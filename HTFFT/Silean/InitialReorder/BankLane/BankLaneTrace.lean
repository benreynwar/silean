import HTFFT.Silean.InitialReorder.BankLane.BankLane

/-! Trace consequences of the natural read-old bank-lane contract. -/

namespace HTFFT.Silean.InitialReorder.BankLane
open FFT

open _root_.Silean
open _root_.Silean.Modules

abbrev InputValues (configuration : Configuration depth) :=
  (ports configuration).inputs.Values

abbrev OutputValues (configuration : Configuration depth) :=
  (ports configuration).outputs.Values

def writeIndex (configuration : Configuration depth)
    (input : InputValues configuration) :
    Fin (RegisterBank.entryCount
      (InitialReorder.addressWidth configuration)) :=
  BitVector.toIndex (InitialReorder.addressWidth configuration)
    (payloadAddress configuration (input .i_writePayload))

def readIndex (configuration : Configuration depth)
    (input : InputValues configuration) :
    Fin (RegisterBank.entryCount
      (InitialReorder.addressWidth configuration)) :=
  BitVector.toIndex (InitialReorder.addressWidth configuration)
    (input .i_readAddress)

def writeData (configuration : Configuration depth)
    (input : InputValues configuration) :
    (sampleType configuration).Denote :=
  payloadData configuration (input .i_writePayload)

/-- State reached after consuming a list of bank inputs. -/
def advance (configuration : Configuration depth) :
    State configuration → List (InputValues configuration) →
      State configuration
  | state, [] => state
  | state, input :: rest =>
      advance configuration
        (nextState configuration (input .i_writePayload)
          (input .i_readAddress) state) rest

/-- Pure output sequence generated by the natural bank transition. -/
def run (configuration : Configuration depth) :
    State configuration → List (InputValues configuration) →
      List ((sampleType configuration).Denote)
  | _, [] => []
  | state, input :: rest =>
      state.output :: run configuration
      (nextState configuration (input .i_writePayload)
          (input .i_readAddress) state) rest

@[simp] theorem run_length (configuration : Configuration depth)
    (state : State configuration)
    (inputs : List (InputValues configuration)) :
    (run configuration state inputs).length = inputs.length := by
  induction inputs generalizing state with
  | nil => rfl
  | cons input inputs induction =>
      simp [run, induction]

theorem observations_of_trace
    (configuration : Configuration depth)
    {initial final : State configuration}
    {inputs : List (InputValues configuration)}
    {outputs : List (OutputValues configuration)}
    (trace : Trace (Transition configuration) initial inputs outputs final) :
    outputs.map (fun output => output .o_data) =
      run configuration initial inputs := by
  induction trace with
  | nil => rfl
  | cons input output step rest induction =>
      rcases step with ⟨outputEqual, nextEqual⟩
      subst nextEqual
      simp only [List.map_cons, run]
      rw [outputEqual, induction]

@[simp] theorem advance_append (configuration : Configuration depth)
    (state : State configuration)
    (left right : List (InputValues configuration)) :
    advance configuration state (left ++ right) =
      advance configuration (advance configuration state left) right := by
  induction left generalizing state with
  | nil => rfl
  | cons input left induction =>
      simp only [List.cons_append, advance]
      exact induction _

@[simp] theorem nextState_entries_writeIndex
    (configuration : Configuration depth)
    (state : State configuration) (input : InputValues configuration) :
    (nextState configuration (input .i_writePayload)
      (input .i_readAddress) state).entries (writeIndex configuration input) =
        writeData configuration input := by
  simp [nextState, writeIndex, writeData]

theorem nextState_entries_other
    (configuration : Configuration depth)
    (state : State configuration) (input : InputValues configuration)
    (index : Fin (RegisterBank.entryCount
      (InitialReorder.addressWidth configuration)))
    (different : index ≠ writeIndex configuration input) :
    (nextState configuration (input .i_writePayload)
      (input .i_readAddress) state).entries index = state.entries index := by
  exact RegisterBank.nextEntries_other
    (InitialReorder.addressWidth configuration) true
    (payloadAddress configuration (input .i_writePayload))
    (payloadData configuration (input .i_writePayload)) state.entries index
    different

theorem advance_entries_preserved
    (configuration : Configuration depth)
    (state : State configuration)
    (inputs : List (InputValues configuration))
    (index : Fin (RegisterBank.entryCount
      (InitialReorder.addressWidth configuration)))
    (different : ∀ input ∈ inputs,
      index ≠ writeIndex configuration input) :
    (advance configuration state inputs).entries index = state.entries index := by
  induction inputs generalizing state with
  | nil => rfl
  | cons input inputs induction =>
      rw [advance]
      rw [induction]
      · exact nextState_entries_other configuration state input index
          (different input (by simp))
      · intro later member
        exact different later (by simp [member])

/-- The final write to an address in a finite input sequence determines that
entry in the state reached after the sequence. -/
theorem advance_entries_of_last_write
    (configuration : Configuration depth)
    (state : State configuration)
    (inputs : List (InputValues configuration))
    (position : Nat) (occurs : position < inputs.length)
    (notOverwritten : ∀ later,
      (afterWrite : position < later) →
      (laterOccurs : later < inputs.length) →
      writeIndex configuration (inputs.get ⟨later, laterOccurs⟩) ≠
        writeIndex configuration (inputs.get ⟨position, occurs⟩)) :
    (advance configuration state inputs).entries
        (writeIndex configuration (inputs.get ⟨position, occurs⟩)) =
      writeData configuration (inputs.get ⟨position, occurs⟩) := by
  induction position generalizing state inputs with
  | zero =>
      cases inputs with
      | nil => simp at occurs
      | cons input inputs =>
          simp only [advance]
          rw [advance_entries_preserved]
          · exact nextState_entries_writeIndex configuration state input
          · intro later member
            obtain ⟨index, equal⟩ := List.get_of_mem member
            subst later
            have different := notOverwritten (index.val + 1)
              (by omega) (by simpa using index.isLt)
            exact Ne.symm (by simpa using different)
  | succ position induction =>
      cases inputs with
      | nil => simp at occurs
      | cons input inputs =>
          have tailOccurs : position < inputs.length := by simpa using occurs
          simp only [advance]
          apply induction _ inputs tailOccurs
          intro later afterWrite laterOccurs
          have different := notOverwritten (later + 1)
            (by omega) (by simpa using laterOccurs)
          simpa using different

/-- Output position `position` observes the output field of the state reached
after the preceding `position` inputs. -/
theorem run_get_eq_advance_output
    (configuration : Configuration depth)
    (state : State configuration)
    (inputs : List (InputValues configuration))
    (position : Nat) (occurs : position < inputs.length) :
    (run configuration state inputs).get ⟨position, by
      simpa using occurs⟩ =
      (advance configuration state (inputs.take position)).output := by
  induction position generalizing state inputs with
  | zero =>
      cases inputs with
      | nil => simp at occurs
      | cons input inputs => rfl
  | succ position induction =>
      cases inputs with
      | nil => simp at occurs
      | cons input inputs =>
          have tailOccurs : position < inputs.length := by simpa using occurs
          simpa [run, advance, List.take_succ_cons] using
            induction
              (nextState configuration (input .i_writePayload)
                (input .i_readAddress) state)
              inputs tailOccurs

/-- A read-old lane returns a previously written value one cycle after the
read.  Writes strictly between the selected write and read must target other
addresses; the write performed on the read cycle itself may collide because
the bank is read-old. -/
theorem output_after_write
    (configuration : Configuration depth)
    {initial final : State configuration}
    {inputs : List (InputValues configuration)}
    {outputs : List (OutputValues configuration)}
    (trace : Trace (Transition configuration) initial inputs outputs final)
    (writePosition readPosition : Nat)
    (writeBeforeRead : writePosition < readPosition)
    (outputOccurs : readPosition + 1 < inputs.length)
    (sameAddress :
      readIndex configuration (inputs.get ⟨readPosition, by omega⟩) =
        writeIndex configuration (inputs.get ⟨writePosition, by omega⟩))
    (notOverwritten : ∀ position,
      (afterWrite : writePosition < position) →
      (beforeRead : position < readPosition) →
      writeIndex configuration (inputs.get ⟨position, by omega⟩) ≠
        writeIndex configuration (inputs.get ⟨writePosition, by omega⟩)) :
    outputs.get ⟨readPosition + 1, by rw [trace.length_eq]; exact outputOccurs⟩
        .o_data =
      writeData configuration
        (inputs.get ⟨writePosition, by omega⟩) := by
  have observations := observations_of_trace configuration trace
  have runOccurs : readPosition + 1 <
      (run configuration initial inputs).length := by
    rw [← observations]
    simp only [List.length_map]
    rw [trace.length_eq]
    exact outputOccurs
  have outputMapOccurs : readPosition + 1 <
      (outputs.map (fun output => output .o_data)).length := by
    simp only [List.length_map]
    rw [trace.length_eq]
    exact outputOccurs
  have outputFromRun := congrArg
    (fun values => values[readPosition + 1]?) observations
  rw [List.getElem?_eq_getElem outputMapOccurs,
    List.getElem?_eq_getElem runOccurs] at outputFromRun
  simp only [List.getElem_map] at outputFromRun
  have outputFromRun' :
      outputs.get ⟨readPosition + 1, by
        rw [trace.length_eq]
        exact outputOccurs⟩ .o_data =
      (run configuration initial inputs).get
        ⟨readPosition + 1, runOccurs⟩ :=
    Option.some.inj outputFromRun
  rw [outputFromRun']
  rw [run_get_eq_advance_output configuration initial inputs
    (readPosition + 1) outputOccurs]
  rw [List.take_add_one]
  have readOccurs : readPosition < inputs.length := by omega
  rw [List.getElem?_eq_getElem readOccurs]
  simp only [advance_append]
  let beforeRead := advance configuration initial (inputs.take readPosition)
  let writeInput := inputs.get ⟨writePosition, by omega⟩
  let readInput := inputs.get ⟨readPosition, readOccurs⟩
  have writeInPrefix : writePosition < (inputs.take readPosition).length := by
    simp
    omega
  have preserved :
      beforeRead.entries (writeIndex configuration writeInput) =
        writeData configuration writeInput := by
    have result := advance_entries_of_last_write configuration initial
      (inputs.take readPosition) writePosition writeInPrefix (by
        intro later afterWrite laterOccurs
        have laterBeforeRead : later < readPosition := by
          rw [List.length_take,
            Nat.min_eq_left (Nat.le_of_lt readOccurs)] at laterOccurs
          exact laterOccurs
        have different := notOverwritten later afterWrite laterBeforeRead
        have laterGet :
            (inputs.take readPosition).get ⟨later, laterOccurs⟩ =
              inputs.get ⟨later, by omega⟩ := by
          exact List.getElem_take
        have writeGet :
            (inputs.take readPosition).get
                ⟨writePosition, writeInPrefix⟩ =
              inputs.get ⟨writePosition, by omega⟩ := by
          exact List.getElem_take
        rw [laterGet, writeGet]
        exact different)
    dsimp only [beforeRead, writeInput]
    have writeGet :
        (inputs.take readPosition).get ⟨writePosition, writeInPrefix⟩ =
          inputs.get ⟨writePosition, by omega⟩ := by
      exact List.getElem_take
    rw [writeGet] at result
    exact result
  change
    (nextState configuration (readInput .i_writePayload)
      (readInput .i_readAddress) beforeRead).output =
      writeData configuration writeInput
  change beforeRead.entries (readIndex configuration readInput) =
    writeData configuration writeInput
  rw [sameAddress]
  exact preserved

end HTFFT.Silean.InitialReorder.BankLane
